<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Datos del Bluetooth de ESTE móvil (el servidor) -->
    <TextView
        android:id="@+id/BT_Name_TextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BT Name:" />

    <TextView
        android:id="@+id/BT_MAC_TextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="BT MAC:" />

    <!-- Botones ACEPTAR y CERRAR conexión, uno al lado del otro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/acceptConnectionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ACCEPT" />

        <Button
            android:id="@+id/closeConnectionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="CLOSE" />
    </LinearLayout>

    <!-- Estado de la conexión y datos del cliente conectado -->
    <TextView
        android:id="@+id/BT_ConnectionState_TextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="NOT CONNECTED"
        android:textStyle="bold" />

    <!-- Datos recibidos del cliente. ScrollView para poder bajar si hay muchos -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:background="#EEEEEE">

        <TextView
            android:id="@+id/receivedEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:fontFamily="monospace" />
    </ScrollView>

    <!-- Texto a enviar al cliente -->
    <EditText
        android:id="@+id/sendTextEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="16dp"
        android:hint="Texto a enviar"
        android:inputType="text" />

    <Button
        android:id="@+id/sendTextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SEND" />

</LinearLayout>